{
  "_note": "② ONVIF：客户端(发现/取流URL) + 服务端(NVR 对 App/平台暴露为 ONVIF 设备)",

  "discovery": {
    "enable": true,
    "interfaces": ["eth1", "eth0"],
    "_note": "eth1 扫 PoE 侧 IPC，eth0 扫 LAN 侧数字通道",
    "interval_s": 30
  },

  "client": {
    "default_user": "admin",
    "default_pass": "",
    "connect_timeout_s": 5,
    "prefer_transport": "rtsp_tcp"
  },

  "server": {
    "enable": true,
    "port": 8000,
    "scopes": [
      "onvif://www.onvif.org/type/network_video_recorder",
      "onvif://www.onvif.org/name/NT12-32"
    ]
  }
}
