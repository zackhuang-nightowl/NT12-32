{
  "device": {
    "model": "NT12-32",
    "soc": "NT98633",
    "name": "NVR-01",
    "sn": ""
  },

  "channels": {
    "_note": "路数配置：capacity=总通道; poe_ports=内建PoE口数; ip_channels=数字通道数",
    "capacity": 32,
    "poe_ports": 16,
    "ip_channels": 16
  },

  "video_out": {
    "_note": "hdmi.resolution 可选 1920x1080 / 3840x2160，按所接屏；设失败自动回落 1920x1080。切 4K 由上层切换接口下发并改 LVGL 配置后重启 LVGL。",
    "hdmi": { "enable": true, "resolution": "1920x1080", "refresh": 60 },
    "cvbs": { "enable": false, "mode": "NTSC" },
    "vga":  { "enable": false, "resolution": "1920x1080" },
    "default_layout": 16,
    "osd": { "channel_name": true, "datetime": true, "event_flag": true }
  },

  "time": {
    "timezone": "America/New_York",
    "ntp": "pool.ntp.org",
    "format24h": true
  },

  "network": {
    "eth0": {
      "role": "mgmt",
      "_note": "默认 DHCP；置 dhcp:false 并填 ip/mask/gw 则用静态",
      "dhcp": true,
      "ip": "192.168.9.114", "mask": "255.255.255.0", "gw": "192.168.9.1"
    },
    "eth1": {
      "role": "poe_uplink",
      "_note": "PoE 汇聚口：物理口 P → 交换芯片 tag VLAN(2000+P)=2001..2016；NVR 侧 eth1.(2000+P)=198.18.P.100，内建 udhcpd 给相机 198.18.P.1。口↔段 1:1(口3→段3，口1→VLAN2001)。与 ODC 固件一致，vlan_base=2000。",
      "mask": "255.255.255.0",
      "vlan_base": 2001,
      "dhcp_server": { "enable": true, "server_ip": "198.18.%d.1", "pool": "198.18.%d.100-199", "mask": "255.255.255.0" }
    }
  }
}
